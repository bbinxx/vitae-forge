# Environmental variables
.env

# Virtual environment
venv/
.venv/
env/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# LaTeX artifacts (build files)
**/*.aux
**/*.log
**/*.out
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.synctex(busy)
**/*.toc
**/*.lof
**/*.lot
**/*.pdf
**/*.bbl
**/*.blg
**/*.run.xml
**/*.bcf

# Project-specific generated artifacts
dist/
logs/
*_temp.tex
LIVE_PREVIEW_TEMP.*

# Editor/System temp files
*.swp
*~
.DS_Store
.idea/
.vscode/

# Keep configs and templates!
!configs/*.json
!shared/*.tex
!scripts/*.py
!scripts/*.sh
!assets/*.jpg
!assets/*.png

# Ignore binary data in shared
shared/*.pdf
