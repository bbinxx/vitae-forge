# ── Environment & Secrets ──
.env

# ── Backend (Python / FastAPI) ──
venv/
__pycache__/
*.pyc
logs/
.pytest_cache/

# ── Frontend (React / Vite) ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.eslintcache

# ── Build & Generated Artifacts ──
dist/
*.temp.tex
**/*.temp.tex
*_temp.tex
**/*_temp.tex

# ── LaTeX Compilation Files ──
**/*.aux
**/*.log
**/*.out
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.synctex(busy)

# ── Editor & OS ──
.DS_Store
.vscode/
.idea/
*.swp
*~

# ── Preserve Important Configuration & Templates ──
!configs/*.json
!templates/tex/*.tex
configs/bookmarks.json

# ── User Uploads ──
assets/*
!assets/.gitkeep

