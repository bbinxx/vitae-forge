# Copy to .env and fill in these backend settings before starting the app.
# Keep the TLS parameters from the connection string provided by Neon.
DATABASE_URL=
TEXCOMPILER_URL=https://texcompiler.example.com
TEXCOMPILER_API_TOKEN=

# Generate a unique secret for a new deployment with: openssl rand -hex 32
# Keep the existing value when upgrading to preserve active sessions.
AUTH_REQUIRED=true
JWT_SECRET=

# Published host port for Docker Compose.
HOST_PORT=5050

# Optional R2 settings for cloud storage.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
